// Exercises actual denomination and removal handlers; no transaction is completed.
function QaCheck(bool passed, String description) {
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  if (report==null) AbortGame("Cannot open regression results");
  if (passed) report.WriteRawLine(String.Format("PASS %s", description));
  else report.WriteRawLine(String.Format("FAIL %s", description));
  report.Close();
}

function QaResetCash() {
  int i=0;
  while (i<5) {changebillslot[i]=0; gCashRegister.Controls[i+9].Visible=false; i++;}
  i=0;
  while (i<9) {changeslot[i]=0; gCashRegister.Controls[i+21].Visible=false; i++;}
  changeclimbing=0.00;
}

function QaRun() {
  CloseAll();
  gPick.Visible=false;
  gCashRegister.Visible=true;
  QaResetCash();
  cr_20_OnClick(null, eMouseLeft);
  cr_10_OnClick(null, eMouseLeft);
  cr_5_OnClick(null, eMouseLeft);
  billtake(cr_Paybill0);
  cr_1_OnClick(null, eMouseLeft);
  QaCheck(cr_Paybill0.Visible, "bill insertion reuses the empty first slot");
  QaCheck((cr_Paybill2.NormalGraphic>=9822)&&(cr_Paybill2.NormalGraphic<=9829), "bill insertion preserves the existing five-dollar bill");
  billtake(cr_Paybill0); billtake(cr_Paybill1); billtake(cr_Paybill2);
  QaCheck((changeclimbing<0.001)&&(changeclimbing>-0.001), "removing the visible bills balances the amount to zero");

  QaResetCash();
  cr_drawerQ_OnClick(null, eMouseLeft);
  cr_drawerD_OnClick(null, eMouseLeft);
  cr_drawerN_OnClick(null, eMouseLeft);
  changetake(cr_change0);
  cr_drawerP_OnClick(null, eMouseLeft);
  QaCheck(cr_change0.Visible, "coin insertion reuses the empty first slot");
  QaCheck((cr_change2.NormalGraphic>=9875)&&(cr_change2.NormalGraphic<=9877), "coin insertion preserves the existing nickel");
  changetake(cr_change0); changetake(cr_change1); changetake(cr_change2);
  QaCheck((changeclimbing<0.001)&&(changeclimbing>-0.001), "removing the visible coins balances the amount to zero");

  QaResetCash();
  int i=0;
  while (i<5) {cr_1_OnClick(null, eMouseLeft); i++;}
  cr_10_OnClick(null, eMouseLeft);
  QaCheck((changeclimbing>4.999)&&(changeclimbing<5.001), "a full bill area rejects extra money");
  QaCheck((cr_Paybill4.NormalGraphic>=9838)&&(cr_Paybill4.NormalGraphic<=9845), "a full bill area preserves the final bill");

  QaResetCash();
  i=0;
  while (i<9) {cr_drawerQ_OnClick(null, eMouseLeft); i++;}
  cr_drawerD_OnClick(null, eMouseLeft);
  QaCheck((changeclimbing>2.249)&&(changeclimbing<2.251), "a full coin area rejects extra money");
  QaCheck((cr_change8.NormalGraphic>=9882)&&(cr_change8.NormalGraphic<=9886), "a full coin area preserves the final coin");

  QaResetCash();
  cr_drawerD_OnClick(null, eMouseLeft);
  QaCheck(changeslot[0]==1, "coin occupancy records one coin per slot");
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  report.WriteRawLine("COMPLETE"); report.Close();
  QuitGame(0);
}
