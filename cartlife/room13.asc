// room script file
function on_event(EventType event, int data) {
    if (event==eEventEnterRoomBeforeFadein){
        button_anim_killer();
        ApplyMusicVolume();

        if ((ampm==0)&&((hour<8)&&(hour>=1))){//Dark - Early Morning
            NatMusic(10); SetBackgroundFrame(1); sun.Graphic=1709; musicplate.Graphic=1765;
        }//Dark
        if ((ampm==0)&&(hour>=8)&&(hour!=12)){//Morning
            NatMusic(20); SetBackgroundFrame(0); sun.Graphic=281; musicplate.Graphic=1764;
        }//Light
        if ((ampm==1)&&(hour==12)){//NOON
            NatMusic(20); SetBackgroundFrame(0); sun.Graphic=281; musicplate.Graphic=1764;
        }//Light
        if ((ampm==1)&&(hour<=8)&&(hour!=12)){//day
            NatMusic(20); SetBackgroundFrame(0); sun.Graphic=281; musicplate.Graphic=1764;
        }//Light
        if ((ampm==1)&&(hour>=9)&&(hour!=12)){//Night
            NatMusic(10); SetBackgroundFrame(1); sun.Graphic=1709; musicplate.Graphic=1765;
        }//Dark
        if ((ampm==0)&&(hour==12)){//Midnight
            NatMusic(10); SetBackgroundFrame(1); sun.Graphic=1709; musicplate.Graphic=1765;
        }//Dark

        bg_bldgs.SetPosition(-10, 141);
        light_1.SetPosition(164, 200);
        light_2.SetPosition(375, 200);
        sun.SetPosition(-150, 36);
        player.Transparency=0;
        musicplate.Transparency=40; musicplate.SetPosition(-75, 198);
        if (GetGlobalInt(GI_ANDRUS_PROGRESS) == 1){
            //SetTimer(10, 40);
        }
        if (Stand.Room==13){Stand.Transparency=0;}

        if (npcLogan_location==13){
            if (Logan.Room!=13){Logan.ChangeRoom(13, 300, 88);}
        }
        if (Logan.Room==13){Logan.Baseline=5;}
    }
}

function room_LeaveLeft(){
    FadeOut(5); player.ManualScaling=false; Wait(5);
    SetGlobalInt(GI_TRAVEL_FROM,13);
    player.ChangeRoom(10, 100, 100);
}

function room_LeaveRight(){
    FadeOut(5); player.ManualScaling=false; Wait(5);
    SetGlobalInt(GI_TRAVEL_FROM,13);
    player.ChangeRoom(10, 100, 100);
}

function room_RepExec(){
    if ((gBonus.Visible==false)&&(gGameover.Visible==false)&&(gBreakdown.Visible==false)&&(gStock.Visible==false)){

        if ((ampm==0)&&((hour<8)&&(hour>=1))){//Dark - Early Morning
            NatMusic(10); SetBackgroundFrame(1); sun.Graphic=1709;
        }//Dark
        if ((ampm==0)&&(hour>=8)&&(hour!=12)){//Morning
            NatMusic(20); SetBackgroundFrame(0); sun.Graphic=281;
        }//Light
        if ((ampm==1)&&(hour==12)){//NOON
            NatMusic(20); SetBackgroundFrame(0); sun.Graphic=281;
        }//Light
        if ((ampm==1)&&(hour<=8)&&(hour!=12)){//day
            NatMusic(20); SetBackgroundFrame(0); sun.Graphic=281;
        }//Light
        if ((ampm==1)&&(hour>=9)&&(hour!=12)){//Night
            NatMusic(10); SetBackgroundFrame(1); sun.Graphic=1709;
        }//Dark
        if ((ampm==0)&&(hour==12)){//Midnight
            NatMusic(10); SetBackgroundFrame(1); sun.Graphic=1709;
        }//Dark

        if (GetBackgroundFrame()==0){if (GetGlobalInt(GI_MUSIC_HOLLOWSTUMP)==0){UnlockMusic(); SetGlobalInt(GI_MUSIC_HOLLOWSTUMP, 1);}}
        if (GetBackgroundFrame()==1){if (GetGlobalInt(GI_MUSIC_BRENNAN)==0){UnlockMusic(); SetGlobalInt(GI_MUSIC_BRENNAN, 1);}}

        if (GetGlobalInt(GI_CHARACTER)==3){Stand.Baseline=(cEgo.y+1);}
        if (GetGlobalInt(GI_CHARACTER)==4){Stand.Baseline=(cLogan.y+1);}

    }
}//End Repex

function room_AfterFadeIn(){  FadeObjectOut_NoBlock(musicplate, 99, 0, 120);}

function room_Leave(){
    button_anim_killer();
    places();
}
