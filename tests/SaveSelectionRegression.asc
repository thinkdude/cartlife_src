// Empty selection must not index Items[-1] after the last save is deleted.
function QaCheck(bool passed, String description) {
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  if (report==null) AbortGame("Cannot open regression results");
  if (passed) report.WriteRawLine(String.Format("PASS %s", description));
  else report.WriteRawLine(String.Format("FAIL %s", description));
  report.Close();
}

function QaRun() {
  CloseAll();
  gPick.Visible=false;
  QaCheck(true, "empty selection test entered");
  lstSaveGames.Clear();
  lstSaveGames.SelectedIndex=-1;
  txtSaveName.Text="stale save name";
  lstSaveGames_OnSelectionChange(null);
  QaCheck(txtSaveName.Text=="", "empty save selection clears its name without crashing");
  lstLoadGames.Clear();
  lstLoadGames.SelectedIndex=-1;
  txtLoadName.Text="stale load name";
  lstLoadGames_OnSelectionChange(null);
  QaCheck(txtLoadName.Text=="", "empty load selection clears its name without crashing");
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  report.WriteRawLine("COMPLETE"); report.Close();
  QuitGame(0);
}
