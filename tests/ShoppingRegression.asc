// Actual purchase callback, stock updates, receipts and inventory in an isolated game.
function QaCheck(bool passed, String description) {
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  if (report==null) AbortGame("Cannot open regression results");
  if (passed) report.WriteRawLine(String.Format("PASS %s", description));
  else report.WriteRawLine(String.Format("FAIL %s", description));
  report.Close();
}

bool QaNear(float actual, float expected) {
  return (actual>expected-0.001)&&(actual<expected+0.001);
}

function QaBuy(int sprite, float price, float cash) {
  CloseAll();
  SetGlobalInt(1,2);
  Customer=Eddie; salebuyer="Eddie";
  kerchekd=true;
  Money=cash;
  localbucks=0.00; walmartia=0.00;
  expense_misc=0.00; expense_total=0.00; expense_supplies=0.00;
  expense_equipment=0.00;
  buyprice=price;
  gBuyItem.BackgroundGraphic=sprite;
  gBuyItem.Visible=true;
  bBuy_Button_OnClick(null,eMouseLeft);
}

function QaExactPurchase(InventoryItem* item, int sprite, float price) {
  cSlot2.InventoryQuantity[item.ID]=0;
  QaBuy(sprite,price,price);
  QaCheck(cSlot2.InventoryQuantity[item.ID]==1,String.Format("exact cash delivers %s",item.Name));
  QaCheck(QaNear(Money,0.00),String.Format("exact cash charges %s once",item.Name));
  QaCheck(QaNear(localbucks,price),String.Format("local spending counts %s once",item.Name));
  QaCheck(QaNear(expense_misc,price),String.Format("expense ledger records %s at the paid price",item.Name));
}

function QaRun() {
  barspeed=1;
  QaExactPurchase(LoBat,5586,6.00);
  QaExactPurchase(Mat64,5588,6.00);
  QaExactPurchase(Pocketmaster,5590,6.00);
  QaExactPurchase(STU,5592,6.00);
  QaExactPurchase(Thirsty,5594,6.00);
  QaExactPurchase(Ligher_cheap,3862,2.00);
  QaExactPurchase(Bigwich,4490,5.20);
  QaExactPurchase(Bigwichv,4492,4.00);
  QaExactPurchase(pingpong,5077,6.00);
  QaExactPurchase(Calamity,5079,6.00);
  QaExactPurchase(Carbon,5081,14.00);
  QaExactPurchase(Tigers,7261,12.00);
  QaExactPurchase(Scandalrag,9950,4.50);
  QaExactPurchase(Acrocircus,9966,6.95);
  QaExactPurchase(Dragonfeet,9968,6.95);
  QaExactPurchase(Fatalsteps,9984,7.50);
  QaExactPurchase(Indianlore,9993,7.75);

  cSlot2.InventoryQuantity[LoBat.ID]=0;
  QaBuy(5586,6.00,8.00);
  QaCheck(cSlot2.InventoryQuantity[LoBat.ID]==1,"purchase with some change delivers the CD");
  QaCheck(QaNear(Money,2.00),"purchase with some change keeps the correct balance");
  cSlot2.InventoryQuantity[LoBat.ID]=0;
  QaBuy(5586,6.00,5.00);
  QaCheck(cSlot2.InventoryQuantity[LoBat.ID]==0,"insufficient cash does not deliver an item");
  QaCheck(QaNear(Money,5.00)&&QaNear(localbucks,0.00),"insufficient cash leaves money and spending unchanged");

  spent_coffeeA=0.00; spent_coffeeS=0.00;
  coffee_s_remaining=0; purchased_coffeeS=0;
  QaBuy(162,70.00,100.00);
  QaCheck(QaNear(spent_coffeeS,70.00),"premium coffee cost goes to grade S");
  QaCheck(QaNear(spent_coffeeA,0.00),"premium coffee does not alter grade A costs");
  QaCheck((coffee_s_remaining==30)&&(purchased_coffeeS==30),"premium coffee delivers and records thirty portions");

  peanutbutter_remaining=0; purchased_peanutbutter=0;
  QaBuy(1215,2.98,2.98);
  QaCheck((peanutbutter_remaining==25)&&(purchased_peanutbutter==25),"supply purchase delivers the correct portions");
  QaCheck(QaNear(expense_supplies,2.98)&&QaNear(Money,0.00),"supply purchase records its actual cost");
  QaCheck(QaLastReceipt()=="$2.98","purchase receipt displays a formatted dollar amount");

  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  report.WriteRawLine("COMPLETE"); report.Close();
  QuitGame(0);
}
