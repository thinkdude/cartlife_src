function QaCheck(bool passed, String description) {
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt",eFileAppend);
  if (report==null) AbortGame("Cannot open regression results");
  if (passed) report.WriteRawLine(String.Format("PASS %s",description));
  else report.WriteRawLine(String.Format("FAIL %s",description));
  report.Close();
}

function QaResetCooking() {
  CloseAll(); SetGlobalInt(1,2); barspeed=1; vitality.Width=120;
  gCook2.Visible=true; gAdd.Visible=false; chefblank();
  Stand.LoseAllInv(); themix.CharacterToUse=Stand;
  player.InventoryQuantity[Vcheese.ID]=0; vcheese_remaining=0;
  player.InventoryQuantity[Bagel_Plain.ID]=0; bagel_plain_remaining=0;
}

function QaSeedFlavors() {
  player.InventoryQuantity[spcBagels1.ID]=1; spcBagels1.Name="Chocolate Bagel"; spcbagels1_remaining=12;
  player.InventoryQuantity[spcBagels2.ID]=1; spcBagels2.Name="Peanut Bagel"; spcbagels2_remaining=12;
  player.InventoryQuantity[spcBagels3.ID]=1; spcBagels3.Name="Grape Bagel"; spcbagels3_remaining=12;
  player.InventoryQuantity[spcBagels4.ID]=1; spcBagels4.Name="Fishy Bagel"; spcbagels4_remaining=12;
}

function QaBakeFlavor(String flavor) {
  gCook2.Visible=true; spcMix=flavor;
  Stand.LoseAllInv(); Stand.AddInventory(dough_bagelS);
  bake_OnClick(null,eMouseLeft);
}

function QaRun() {
  SetGameSpeed(200);
  QaResetCooking(); buttermilk_remaining=1; salt_remaining=1; milk_remaining=4;
  cb_creamcheese_OnClick(null,eMouseLeft);
  QaCheck(vcheese_remaining==0,"cream cheese rejects fewer than two buttermilk portions");
  QaCheck((buttermilk_remaining==1)&&(salt_remaining==1)&&(milk_remaining==4),"rejected cream cheese preserves all ingredients");
  QaResetCooking(); buttermilk_remaining=2; salt_remaining=1; milk_remaining=4;
  cb_creamcheese_OnClick(null,eMouseLeft);
  QaCheck((vcheese_remaining==10)&&(player.InventoryQuantity[Vcheese.ID]==1),"exact cream-cheese ingredients produce ten portions");
  QaCheck((buttermilk_remaining==0)&&(salt_remaining==0)&&(milk_remaining==0),"cream cheese consumes its exact recipe quantities");

  QaResetCooking(); yeast_remaining=2; salt_remaining=3; sugar_remaining=-1; flour_remaining=8;
  cb_Bagelp_OnClick(null,eMouseLeft);
  QaCheck(bagel_plain_remaining==0,"bagel recipe rejects negative sugar stock");
  QaCheck((yeast_remaining==2)&&(salt_remaining==3)&&(sugar_remaining==-1)&&(flour_remaining==8),"rejected bagel recipe preserves ingredients");
  QaResetCooking(); yeast_remaining=2; salt_remaining=3; sugar_remaining=1; flour_remaining=8;
  cb_Bagelp_OnClick(null,eMouseLeft);
  QaCheck((bagel_plain_remaining==12)&&(player.InventoryQuantity[Bagel_Plain.ID]==1),"exact plain-bagel recipe produces twelve bagels");
  QaCheck((yeast_remaining==0)&&(salt_remaining==0)&&(sugar_remaining==0)&&(flour_remaining==0),"plain bagels consume the exact recipe quantities");

  QaResetCooking(); QaSeedFlavors();
  QaBakeFlavor("Cocoa");
  QaCheck(spcbagels1_remaining==24,"restocking flavor one adds twelve to its existing batch");
  QaBakeFlavor("Peanut Butter");
  QaCheck(spcbagels2_remaining==24,"restocking flavor two adds twelve to its existing batch");
  QaBakeFlavor("Jelly");
  QaCheck(spcbagels3_remaining==24,"restocking flavor three adds twelve to its existing batch");
  QaBakeFlavor("Lox");
  QaCheck(spcbagels4_remaining==24,"restocking flavor four adds twelve to its existing batch");
  QaCheck(Stand.InventoryQuantity[dough_bagelS.ID]==0,"successful flavored batches consume their dough");

  QaResetCooking(); QaSeedFlavors(); player.InventoryQuantity[spcBagels3.ID]=0; spcbagels3_remaining=0;
  QaBakeFlavor("Peanut Butter");
  QaCheck((spcbagels2_remaining==24)&&(player.InventoryQuantity[spcBagels3.ID]==0),"restocking uses a matching flavor before an empty slot");

  QaResetCooking(); QaSeedFlavors();
  QaBakeFlavor("Chili");
  QaCheck(Stand.InventoryQuantity[dough_bagelS.ID]==1,"full flavor capacity preserves unbaked dough");
  QaCheck(!gPick.Visible&&close_pick.Visible,"full flavor capacity releases the cooking overlay");
  QaCheck((spcbagels1_remaining==12)&&(spcbagels2_remaining==12)&&(spcbagels3_remaining==12)&&(spcbagels4_remaining==12),"full flavor capacity preserves all existing batches");

  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt",eFileAppend);
  report.WriteRawLine("COMPLETE"); report.Close(); QuitGame(0);
}
