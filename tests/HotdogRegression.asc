// Real Toppins negotiation, cancellation and pricing in the AGS engine.
// The disposable fixture skips dialogue waits and counts preparation calls.
function QaCheck(bool passed, String description) {
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  if (report==null) AbortGame("Cannot open regression results");
  if (passed) report.WriteRawLine(String.Format("PASS %s", description));
  else report.WriteRawLine(String.Format("FAIL %s", description));
  report.Close();
}

function QaHotdogPrepare(int preference, int choice) {
  CloseAll();
  SetGlobalInt(1,3);
  Customer=Richard;
  salebuyer="Richard";
  Customer.SetProperty("prefHotdog", preference);
  Customer.SetProperty("limitHotdog", 500);
  saleitem="Hot Dog";
  HotdogPrice=1.00;
  saleprice=1.00;
  repmod=0.00;
  SaleInProgress=1;
  hotdog_bonus_countdown=10;
  gDialog.Visible=true;
  DBG0.NormalGraphic=2184;
  player.InventoryQuantity[Ketchup.ID]=1;
  player.InventoryQuantity[Mustard.ID]=1;
  player.InventoryQuantity[Chilli.ID]=1;
  player.InventoryQuantity[Sauerkraut.ID]=1;
  player.InventoryQuantity[Jalapenos.ID]=1;
  player.InventoryQuantity[Relish.ID]=1;
  ketchup_remaining=10; mustard_remaining=10; chilli_remaining=10;
  sauerkraut_remaining=10; jalapenos_remaining=10; relish_remaining=10;
  KetchupPrice=0.00; MustardPrice=0.00; ChilliPrice=0.00;
  KrautPrice=0.00; JalapenoPrice=0.00; RelishPrice=0.00;
  QaHotdogReset(choice);
}

function QaRun() {
  QaHotdogPrepare(5,0); KrautPrice=10.00;
  Customer.Toppins();
  QaCheck(SaleInProgress==0, "declined kraut order cancels the sale");
  QaCheck(QaHotdogMakeCount()==0, "declined order does not enter preparation");
  QaCheck(hotdog_bonus_countdown==10, "declined order does not consume a preparation bonus");

  QaHotdogPrepare(5,1); KrautPrice=10.00;
  Customer.Toppins();
  QaCheck(SaleInProgress==1, "accepting a plain fallback keeps the sale active");
  QaCheck(QaHotdogMakeCount()==1, "accepted plain fallback enters preparation exactly once");

  QaHotdogPrepare(1,0); KetchupPrice=0.01;
  Customer.Toppins();
  QaCheck(saleitem=="Orange Dog", "one-cent ketchup and mustard order retains its toppings");
  QaCheck((saleprice>1.009)&&(saleprice<1.011), "one-cent ketchup and mustard price is charged");

  QaHotdogPrepare(2,0); ChilliPrice=0.01;
  Customer.Toppins();
  QaCheck(saleitem=="Chili Dog", "one-cent chili order retains its topping");
  QaCheck((saleprice>1.009)&&(saleprice<1.011), "one-cent chili price is charged");

  QaHotdogPrepare(3,0);
  Customer.Toppins();
  QaCheck(saleitem=="Everything Dog", "affordable everything order is accepted");
  QaCheck((saleprice>0.999)&&(saleprice<1.001), "everything order charges the base hot dog once");

  QaHotdogPrepare(3,0); ChilliPrice=0.01; JalapenoPrice=0.01;
  KetchupPrice=0.01; MustardPrice=0.01; RelishPrice=0.01;
  Customer.Toppins();
  QaCheck((saleprice>1.049)&&(saleprice<1.051), "everything order includes each one-cent topping once");

  QaHotdogPrepare(5,0); KrautPrice=0.01;
  Customer.Toppins();
  QaCheck((saleitem=="Kraut Dog")&&(saleprice>1.009)&&(saleprice<1.011), "one-cent sauerkraut order has the correct item and price");

  QaHotdogPrepare(5,0); sauerkraut_remaining=0;
  Customer.Toppins();
  QaCheck((SaleInProgress==0)&&(QaHotdogMakeCount()==0), "depleted sauerkraut cannot start a refused order");

  QaHotdogPrepare(1,0); KetchupPrice=10.00;
  Customer.Toppins();
  QaCheck((SaleInProgress==0)&&(QaHotdogMakeCount()==0), "refused ketchup and mustard order does not enter preparation");
  QaHotdogPrepare(2,0); ChilliPrice=10.00;
  Customer.Toppins();
  QaCheck((SaleInProgress==0)&&(QaHotdogMakeCount()==0), "refused chili order does not enter preparation");
  QaHotdogPrepare(3,0); ChilliPrice=10.00;
  Customer.Toppins();
  QaCheck((SaleInProgress==0)&&(QaHotdogMakeCount()==0), "refused everything order does not enter preparation");

  QaHotdogPrepare(1,1); ketchup_remaining=0;
  Customer.Toppins();
  QaCheck(saleitem=="Yellow Dog", "empty ketchup counter offers only available mustard");
  QaHotdogPrepare(1,1); player.InventoryQuantity[Ketchup.ID]=0;
  Customer.Toppins();
  QaCheck(saleitem=="Yellow Dog", "missing ketchup inventory offers only available mustard");
  QaHotdogPrepare(1,1); mustard_remaining=-1;
  Customer.Toppins();
  QaCheck(saleitem=="Red Dog", "negative mustard stock offers only available ketchup");
  QaHotdogPrepare(2,0); chilli_remaining=0;
  Customer.Toppins();
  QaCheck((SaleInProgress==0)&&(QaHotdogMakeCount()==0), "empty chili counter takes the unavailable-stock refusal path");
  QaHotdogPrepare(2,0); player.InventoryQuantity[Chilli.ID]=0;
  Customer.Toppins();
  QaCheck((SaleInProgress==0)&&(QaHotdogMakeCount()==0), "missing chili inventory takes the unavailable-stock refusal path");
  QaHotdogPrepare(2,0); chilli_remaining=-1;
  Customer.Toppins();
  QaCheck((SaleInProgress==0)&&(QaHotdogMakeCount()==0), "negative chili stock takes the unavailable-stock refusal path");

  QaHotdogPrepare(3,0); Customer.SetProperty("limitHotdog",100);
  Customer.Toppins();
  QaCheck(saleitem=="Everything Dog", "everything order at the exact budget limit is accepted");
  QaHotdogPrepare(5,0);
  Customer.Toppins();
  QaCheck((saleitem=="Kraut Dog")&&(saleprice>0.999)&&(saleprice<1.001), "free sauerkraut order keeps the base price");
  QaHotdogPrepare(5,0); KrautPrice=0.25;
  Customer.Toppins();
  QaCheck((saleitem=="Kraut Dog")&&(saleprice>1.249)&&(saleprice<1.251), "paid sauerkraut order adds its price once");
  QaHotdogPrepare(5,0); player.InventoryQuantity[Sauerkraut.ID]=0;
  Customer.Toppins();
  QaCheck((SaleInProgress==0)&&(QaHotdogMakeCount()==0), "missing sauerkraut inventory cannot start a refused order");
  QaHotdogPrepare(5,0); sauerkraut_remaining=-1;
  Customer.Toppins();
  QaCheck((SaleInProgress==0)&&(QaHotdogMakeCount()==0), "negative sauerkraut stock cannot start a refused order");

  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  report.WriteRawLine("COMPLETE"); report.Close();
  QuitGame(0);
}
