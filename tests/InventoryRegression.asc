// Runs real inventory description, confirmation and consumption callbacks,
// including their normal eating/drinking animations, with Melanie selected.
function QaCheck(bool passed, String description) {
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  if (report==null) AbortGame("Cannot open regression results");
  if (passed) report.WriteRawLine(String.Format("PASS %s", description));
  else report.WriteRawLine(String.Format("FAIL %s", description));
  report.Close();
}

function QaPrepareMeal() {
  CloseAll(); gCook2.Visible=false;
  SetGlobalInt(1,2);
  bd_favfood.Text="None";
  nutrition.Width=20; vitality.Width=120;
}

function QaEat() {
  smoke_button_OnClick(null,eMouseLeft);
  QaCheck(gEatdrink.Visible,"inventory action opens food confirmation");
  eatdrinkbutton_OnClick(null,eMouseLeft);
  QaCheck(!gEatdrink.Visible&&!gPick.Visible,"consumption finishes and releases its animation overlay");
}

function QaRun() {
  QaPrepareMeal();
  cSlot2.InventoryQuantity[Oldsand.ID]=1;
  cSlot2.InventoryQuantity[Dayold.ID]=1;
  Oldsand_Look(); QaEat();
  QaCheck(cSlot2.InventoryQuantity[Oldsand.ID]==0,"eating an old sandwich removes the old sandwich");
  QaCheck(cSlot2.InventoryQuantity[Dayold.ID]==1,"eating an old sandwich preserves the day-old sandwich");

  QaPrepareMeal();
  cSlot2.InventoryQuantity[Oldsand.ID]=1;
  cSlot2.InventoryQuantity[Dayold.ID]=1;
  Dayold_Look(); QaEat();
  QaCheck(cSlot2.InventoryQuantity[Dayold.ID]==0,"eating a day-old sandwich removes that sandwich");
  QaCheck(cSlot2.InventoryQuantity[Oldsand.ID]==1,"eating a day-old sandwich preserves the old sandwich");

  QaPrepareMeal(); cSlot2.InventoryQuantity[Bigwich.ID]=1;
  Bigwich_Look(); QaEat();
  QaCheck(cSlot2.InventoryQuantity[Bigwich.ID]==0,"eating the meat sandwich removes its inventory item");
  QaPrepareMeal(); cSlot2.InventoryQuantity[Bigwichv.ID]=1;
  Bigwichv_Look(); QaEat();
  QaCheck(cSlot2.InventoryQuantity[Bigwichv.ID]==0,"eating the veggie sandwich removes its inventory item");

  QaPrepareMeal(); milk_remaining=3;
  Milk_Look(); QaEat();
  QaCheck(milk_remaining==2,"drinking milk consumes one portion");
  QaPrepareMeal(); cocoa_remaining=3;
  Cocoa_Look(); QaEat();
  QaCheck(cocoa_remaining==2,"drinking cocoa consumes one portion");

  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  report.WriteRawLine("COMPLETE"); report.Close();
  QuitGame(0);
}
