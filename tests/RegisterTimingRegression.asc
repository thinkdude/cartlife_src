function QaCheck(bool passed,String description) {
  File* f=File.Open("$SAVEGAMEDIR$/regression-results.txt",eFileAppend);
  if (f==null) AbortGame("Cannot open regression results");
  if (passed) f.WriteRawLine(String.Format("PASS %s",description));
  else f.WriteRawLine(String.Format("FAIL %s",description));
  f.Close();
}
function QaRegister() {
  CloseAll(); SetGlobalInt(1,3); gCashRegister.Visible=true;
  cranked=false; paycranked=false; donecranked=false; drawerisslid=false;
  qaCheckoutCalls=0; total_botched=0; vitality.Width=120;
  changeclimbing=0.00; ChangeAnswer=4.00;
  gAssemble.Visible=false; cr_Lock.NormalGraphic=9805;
}
function QaRun() {
  QaRegister(); cr_lock_OnClick(null,eMouseLeft);
  QaCheck(cranked,"first key click opens a closed register regardless of its animation frame");
  QaCheck(total_botched==0,"first key click does not mark a sale failed");

  QaRegister(); cr_Lock.NormalGraphic=9804;
  cr_lock_OnClick(null,eMouseLeft); cr_lock_OnClick(null,eMouseLeft);
  QaCheck((total_botched==0)&&(qaCheckoutCalls==0),"rapid second key click is ignored while the drawer opens");

  QaRegister(); drawerisslid=true; paycranked=true;
  cr_lock_OnClick(null,eMouseLeft);
  QaCheck((total_botched==0)&&(qaCheckoutCalls==0),"key click waits for the customer's cash animation");

  QaRegister(); drawerisslid=true;
  cr_lock_OnClick(null,eMouseLeft);
  QaCheck((total_botched==1)&&(qaCheckoutCalls==0),"an open ready register still rejects incorrect change");

  QaRegister(); drawerisslid=true; changeclimbing=4.00;
  cr_lock_OnClick(null,eMouseLeft);
  QaCheck((total_botched==0)&&(qaCheckoutCalls==1)&&donecranked,"correct change completes a ready sale");
  cr_lock_OnClick(null,eMouseLeft);
  QaCheck(qaCheckoutCalls==1,"repeated closing clicks cannot complete a sale twice");

  Mouse.SetPosition(10,90);
  QaRegister(); cr_Drawer_OnClick(null,eMouseLeft);
  QaCheck((total_botched==0)&&(qaCheckoutCalls==0),"closed drawer click cannot fail a sale");
  QaRegister(); drawerisslid=true; paycranked=true;
  cr_Drawer_OnClick(null,eMouseLeft);
  QaCheck((total_botched==0)&&(qaCheckoutCalls==0),"drawer click waits for the customer's cash animation");
  QaRegister(); drawerisslid=true; changeclimbing=4.00;
  cr_Drawer_OnClick(null,eMouseLeft);
  QaCheck((qaCheckoutCalls==1)&&donecranked,"drawer click completes correct change when ready");
  cr_Drawer_OnClick(null,eMouseLeft);
  QaCheck(qaCheckoutCalls==1,"repeated drawer clicks cannot complete a sale twice");
  File* f=File.Open("$SAVEGAMEDIR$/regression-results.txt",eFileAppend);
  f.WriteRawLine("COMPLETE"); f.Close(); QuitGame(0);
}
