// Injected into a disposable test project by Run-Regression.ps1 only.
File* qaResults;

function QaCheck(bool passed, String description) {
  if (passed) qaResults.WriteRawLine(String.Format("PASS %s", description));
  else qaResults.WriteRawLine(String.Format("FAIL %s", description));
}

function QaRun() {
  qaResults=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileWrite);
  if (qaResults==null) AbortGame("Cannot open regression results");

  // Keep this test in the intro room so no hotel/story transition is scheduled.
  cAndrus.ChangeRoom(player.Room, player.x, player.y);
  cAndrus.SetAsPlayer();
  cAndrus.SetIdleView(-1, 0);
  CloseAll();
  gPick.Visible=false;
  gToothbrushing.Visible=false;
  gBreakdown.Visible=false;
  mouse.Visible=false;
  SetGlobalInt(1, 1);

  int level=1;
  while (level<=3) {
    player.UnlockView();
    player.ChangeView(3);
    player.Loop=0;
    SetGlobalInt(52, 1);
    if (level==1) caffeine.Width=40;
    else if (level==2) caffeine.Width=15;
    else caffeine.Width=5;
    int oldRoom=player.Room;
    int oldX=player.x;
    int oldY=player.y;
    SetTimer(19, 1);
    Wait(2);
    UpdateAndrusWithdrawal();
    QaCheck(withdrawel==level, String.Format("standing severity %d", level));
    QaCheck(player.View==player.NormalView, String.Format("standing severity %d releases cough view", level));
    QaCheck(!player.Animating, String.Format("standing severity %d completes animation", level));
    QaCheck((player.Room==oldRoom)&&(player.x==oldX)&&(player.y==oldY), String.Format("standing severity %d preserves location", level));

    player.UnlockView();
    player.ChangeView(71);
    player.Animate(0, 3, eRepeat, eNoBlock);
    SetGlobalInt(52, 0);
    SetTimer(19, 1);
    Wait(2);
    UpdateAndrusWithdrawal();
    QaCheck((player.View==71)&&(player.Loop==0)&&player.Animating, String.Format("seated severity %d resumes idle", level));
    QaCheck((player.Room==oldRoom)&&(player.x==oldX)&&(player.y==oldY), String.Format("seated severity %d preserves location", level));
    level++;
  }

  player.UnlockView();
  player.ChangeView(3);
  SetGlobalInt(52, 1);
  caffeine.Width=110;
  SetTimer(19, 1);
  Wait(2);
  UpdateAndrusWithdrawal();
  QaCheck(withdrawel==0, "recovered nicotine clears withdrawal");
  QaCheck((player.View==3)&&!player.Animating, "recovered nicotine does not cough");

  SetGlobalInt(1, 2);
  caffeine.Width=5;
  SetTimer(19, 1);
  Wait(2);
  UpdateAndrusWithdrawal();
  QaCheck(withdrawel==0, "withdrawal does not leak into another character");
  QaCheck((player.View==3)&&!player.Animating, "another character does not use Andrus cough view");

  qaResults.WriteRawLine("COMPLETE");
  qaResults.Close();
  QuitGame(0);
}
