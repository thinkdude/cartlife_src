// Calls the actual save/load GUI handlers in an isolated profile.
int qaSavePhase;
int qaCapacitySlot;

bool QaSlotHasName(int slot, String name) {
  String description=Game.GetSaveSlotDescription(slot);
  if (description==null) return false;
  return description==name;
}

function QaCheck(bool passed, String description) {
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  if (report==null) AbortGame("Cannot open regression results");
  if (passed) report.WriteRawLine(String.Format("PASS %s", description));
  else report.WriteRawLine(String.Format("FAIL %s", description));
  report.Close();
}

function QaFinish() {
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  report.WriteRawLine("COMPLETE");
  report.Close();
  QuitGame(0);
}

function QaRun() {
  CloseAll();
  gPick.Visible=false;
  lstSaveGames.FillSaveGameList();
  lstSaveGames.SelectedIndex=-1;
  txtSaveName.Text="First manual save";
  qaSavePhase=1;
  btnConfirmSave_OnClick(null, eMouseLeft);
}

function QaSaveTick() {
  // Restored snapshots have an earlier phase; this marker is outside save state.
  if (File.Exists("$SAVEGAMEDIR$/qa-load-requested")) {
    QaCheck(Money==33.00, "load handler restores the selected list's slot despite another list refresh");
    QaFinish();
    return;
  }
  if (qaSavePhase==1) {
    QaCheck(Game.GetSaveSlotDescription(1)==null, "first manual save leaves reserved autosave slot 1 unused");
    QaCheck(QaSlotHasName(4, "First manual save"), "first manual save uses slot 4");
    int slot=1;
    while (slot<=100) {DeleteSaveSlot(slot); slot++;}
    qaSavePhase=2;
    SaveGameSlot(1, "Andrus Autosave");
  }
  else if (qaSavePhase==2) {
    qaSavePhase=3;
    Money=33.00;
    SaveGameSlot(3, "Vinny Autosave");
  }
  else if (qaSavePhase==3) {
    qaSavePhase=4;
    Money=44.00;
    SaveGameSlot(4, "Protected manual save");
  }
  else if (qaSavePhase==4) {
    lstSaveGames.FillSaveGameList();
    lstSaveGames.SelectedIndex=-1;
    txtSaveName.Text="New manual save";
    qaSavePhase=5;
    btnConfirmSave_OnClick(null, eMouseLeft);
  }
  else if (qaSavePhase==5) {
    QaCheck(QaSlotHasName(4, "Protected manual save"), "new manual save preserves occupied slot after a gap");
    QaCheck(QaSlotHasName(5, "New manual save"), "new manual save uses the next genuinely free slot");
    QaCheck(QaSlotHasName(1, "Andrus Autosave"), "new manual save preserves Andrus autosave");
    QaCheck(QaSlotHasName(3, "Vinny Autosave"), "new manual save preserves Vinny autosave");
    qaSavePhase=6;
    SaveGameSlot(4, "Protected manual save");
  }
  else if (qaSavePhase==6) {
    lstSaveGames.FillSaveGameList(4, 4);
    lstSaveGames.SelectedIndex=0;
    txtSaveName.Text="Protected manual save";
    // Refresh a different list: the legacy global savegameindex now maps 0 to 3.
    lstLoadGames.FillSaveGameList(3, 3);
    qaSavePhase=7;
    btnConfirmSave_OnClick(null, eMouseLeft);
  }
  else if (qaSavePhase==7) {
    QaCheck(QaSlotHasName(3, "Vinny Autosave"), "explicit overwrite uses the save list's own slot map");
    qaSavePhase=8;
    Money=33.00;
    SaveGameSlot(3, "Vinny Autosave");
  }
  else if (qaSavePhase==8) {
    lstSaveGames.FillSaveGameList(4, 4);
    lstSaveGames.SelectedIndex=0;
    lstLoadGames.FillSaveGameList(3, 3);
    btnDeleteSave_OnClick(null, eMouseLeft);
    QaCheck(Game.GetSaveSlotDescription(4)==null, "save-menu delete removes its selected save");
    QaCheck(QaSlotHasName(3, "Vinny Autosave"), "save-menu delete preserves the other list's save");
    qaSavePhase=9;
    SaveGameSlot(3, "Vinny Autosave");
  }
  else if (qaSavePhase==9) {
    lstLoadGames.FillSaveGameList(3, 3);
    lstLoadGames.SelectedIndex=0;
    lstSaveGames.FillSaveGameList(1, 1);
    Button16_OnClick(null, eMouseLeft);
    QaCheck(Game.GetSaveSlotDescription(3)==null, "load-menu delete removes its selected save");
    QaCheck(QaSlotHasName(1, "Andrus Autosave"), "load-menu delete preserves the other list's save");
    qaSavePhase=10;
    Money=33.00;
    SaveGameSlot(3, "Vinny Autosave");
  }
  else if (qaSavePhase==10) {
    if (qaCapacitySlot==0) qaCapacitySlot=4;
    if (qaCapacitySlot<24) {
      SaveGameSlot(qaCapacitySlot, String.Format("Capacity %d", qaCapacitySlot));
      qaCapacitySlot++;
    }
    else {
      lstSaveGames.FillSaveGameList(4, 23);
      lstSaveGames.SelectedIndex=-1;
      txtSaveName.Text="Overflow save";
      qaSavePhase=11;
      btnConfirmSave_OnClick(null, eMouseLeft);
    }
  }
  else if (qaSavePhase==11) {
    QaCheck(QaSlotHasName(21, "Capacity 21"), "full save list does not overwrite a slot when nothing is selected");
    qaSavePhase=12;
    Money=11.00;
    SaveGameSlot(1, "Andrus Autosave");
  }
  else if (qaSavePhase==12) {
    qaSavePhase=13;
    Money=33.00;
    SaveGameSlot(3, "Vinny Autosave");
  }
  else if (qaSavePhase==13) {
    lstLoadGames.FillSaveGameList(3, 3);
    lstLoadGames.SelectedIndex=0;
    txtLoadName.Text="Vinny Autosave";
    lstSaveGames.FillSaveGameList(1, 1);
    Money=99.00;
    File* marker=File.Open("$SAVEGAMEDIR$/qa-load-requested", eFileWrite);
    marker.WriteRawLine("1");
    marker.Close();
    Button9_OnClick(null, eMouseLeft);
  }
}
