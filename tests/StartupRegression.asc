// Injected into a disposable project only; tests the real newgame/save/restore code.
#define QA_CHARACTER __CHARACTER__
int qaStartupPhase;

function QaCheck(bool passed, String description) {
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  if (report==null) AbortGame("Cannot open regression results");
  if (passed) report.WriteRawLine(String.Format("PASS %s", description));
  else report.WriteRawLine(String.Format("FAIL %s", description));
  report.Close();
}

function QaMarker(String name) {
  File* marker=File.Open(String.Format("$SAVEGAMEDIR$/%s", name), eFileWrite);
  if (marker==null) AbortGame("Cannot write regression marker");
  marker.WriteRawLine("1");
  marker.Close();
}

function QaCheckStartupState() {
  QaCheck(GetGlobalInt(1)==QA_CHARACTER, "selected protagonist persists");
  QaCheck(player.Room==23, "protagonist starts in prologue room");
  if (QA_CHARACTER==1) {
    QaCheck(player==cAndrus, "Andrus is the player");
    QaCheck(Money==2250.00, "Andrus starting money is 2250.00");
    QaCheck(cSlot2.InventoryQuantity[Lighter.ID]>0, "Andrus has his lighter");
  }
  else if (QA_CHARACTER==2) {
    QaCheck(player==cMelanie, "Melanie is the player");
    QaCheck(Money==1560.00, "Melanie starting money is 1560.00");
    QaCheck(cSlot2.InventoryQuantity[Cellphone.ID]>0, "Melanie has her cellphone");
  }
  else {
    QaCheck(player==cEgo, "Vinny is the player");
    QaCheck(Money==202.60, "Vinny starting money is 202.60");
    QaCheck(cSlot2.InventoryQuantity[Recipebook_V.ID]>0, "Vinny has his recipe book");
  }
}

function QaRun() {
  QaCheck(true, "startup harness entered");
  if (File.Exists("$SAVEGAMEDIR$/qa-restart-requested")) {
    QaCheck(player==cEgo, "restart restores initial player");
    QaCheck(player.Room==1, "restart returns to character selection");
    QaCheck(Game.GetSaveSlotDescription(40)=="QA Startup snapshot", "restart preserves saved game on disk");
    File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
    report.WriteRawLine("COMPLETE");
    report.Close();
    QuitGame(0);
    return;
  }
  SetGlobalInt(1, QA_CHARACTER);
  qaStartupPhase=1;
  newgame();
  QaCheck(true, "newgame initialization returned");
}

function QaStartupTick() {
  if (qaStartupPhase==1) {
    QaCheckStartupState();
    qaStartupPhase=2;
    SaveGameSlot(40, "QA Startup snapshot");
  }
  else if (qaStartupPhase==2) {
    QaCheck(Game.GetSaveSlotDescription(40)=="QA Startup snapshot", "save creates the requested slot");
    if (!File.Exists("$SAVEGAMEDIR$/qa-restore-requested")) {
      QaMarker("qa-restore-requested");
      Money=1.00;
      if (QA_CHARACTER==1) cSlot2.LoseInventory(Lighter);
      else if (QA_CHARACTER==2) cSlot2.LoseInventory(Cellphone);
      else cSlot2.LoseInventory(Recipebook_V);
      RestoreGameSlot(40);
    }
    else {
      QaCheckStartupState();
      if (File.Exists("$SAVEGAMEDIR$/qa-fresh-process")) QaCheck(true, "save restored in a fresh game process");
      QaMarker("qa-restart-requested");
      RestartGame();
    }
  }
}

function QaSelectionTick() {
  if (qaStartupPhase==0) QaRun();
}
