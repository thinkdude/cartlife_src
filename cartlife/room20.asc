// room script file
function on_event(EventType event, int data) {
    if (event==eEventEnterRoomBeforeFadein){
        button_anim_killer();
        ApplyMusicVolume();

        player.Transparency=0;
        if ((ampm==0)&&((hour<8)&&(hour>=1))){//Dark - Early Morning
            NatMusic(27); SetBackgroundFrame(1); sun.Graphic=1709; mtns.Graphic=1712;  oObject2.Graphic=1711; org_door.Graphic=5448; awning.Graphic=5156;
        }//Dark
        if ((ampm==0)&&(hour>=8)&&(hour!=12)){//Morning
            NatMusic(26); SetBackgroundFrame(0); sun.Graphic=281; mtns.Graphic=124; oObject2.Graphic=400; org_door.Graphic=5449; awning.Graphic=5155;
        }//Light
        if ((ampm==1)&&(hour==12)){//NOON
            NatMusic(26); SetBackgroundFrame(0); sun.Graphic=281; mtns.Graphic=124; oObject2.Graphic=400; org_door.Graphic=5449; awning.Graphic=5155;
        }//Light
        if ((ampm==1)&&(hour<=8)&&(hour!=12)){//day
            NatMusic(26); SetBackgroundFrame(0); sun.Graphic=281; mtns.Graphic=124; oObject2.Graphic=400; org_door.Graphic=5449; awning.Graphic=5155;
        }//Light
        if ((ampm==1)&&(hour>=9)&&(hour!=12)){//Night
            NatMusic(27); SetBackgroundFrame(1); sun.Graphic=1709; mtns.Graphic=1712;  oObject2.Graphic=1711; org_door.Graphic=5448; awning.Graphic=5156;
        }//Dark
        if ((ampm==0)&&(hour==12)){//Midnight
            NatMusic(27); SetBackgroundFrame(1); sun.Graphic=1709; mtns.Graphic=1712;  oObject2.Graphic=1711; org_door.Graphic=5448; awning.Graphic=5156;
        }//Dark

        musicplate.Transparency=40; musicplate.SetPosition(-75, 240);
        sun.SetPosition(0, 76);
        mtns.SetPosition(0, 87);//+20
        if (GetGlobalInt(GI_ANDRUS_PROGRESS) == 1){}
        if (Stand.Room==20){Stand.Transparency=0;}
    }
}

//////////  Superstore Anim ------------------------------ Superstore Anim ------//
function superwalk(){
    if (GetGlobalInt(GI_CHARACTER) == 1) {ssanim_char.Animate(23, 1, 3, eRepeat);}//Andrus!
    if (GetGlobalInt(GI_CHARACTER) == 2) {ssanim_char.Animate(1, 1, 3, eRepeat);}//Melanie!
    if (GetGlobalInt(GI_CHARACTER) == 3) {ssanim_char.Animate(4, 2, 3, eRepeat);}//Vinny!
    if (GetGlobalInt(GI_CHARACTER) == 4) {ssanim_char.Animate(22, 1, 3, eRepeat);}//Logan!
}


function room_LeaveLeft()
{
    FadeOut(5);
    player.ManualScaling=false;
    Wait(5);
    SetGlobalInt(GI_TRAVEL_FROM,20);
    player.ChangeRoom(10, 100, 100);
}

function room_LeaveRight()
{
    FadeOut(5);
    player.ManualScaling=false;
    Wait(5);
    SetGlobalInt(GI_TRAVEL_FROM,20);
    player.ChangeRoom(10, 100, 100);
}

function region1_Standing(){//Roastierry
    if((IsKeyPressed(eKeyUpArrow)==1)||(IsKeyPressed(eKeyW)==1)&&(gMake.Visible==false)){
        if (((ampm==1)&&(hour>9)&&(hour!=12))||((ampm==0)&&((hour<6)))||(GetGlobalInt(GI_BARNEYS_PLOT)==7)||((ampm==0)&&((hour==12)))){
            Wait(5); player.DoorHandle(); Wait(20); PlaySound(60);
            TopUp("It's locked", "Hours:[6:00am - 10:00pm[Serving Georgetown's Best Coffee[Seven Days a Week");  player.DoorHandle2();
        }
        else
        {
            if ((GetGlobalInt(GI_CHARACTER)==3)&&(GetGlobalInt(GI_CART_STATE) == 1)){SetGlobalInt(GI_CART_STATE, 3);Stand.FollowCharacter(null, 0, 0); SetGlobalInt(GI_CART_STATE, 3); Wait(5);}
            player.DoorHandle();
            PlayDoorOpenSound();
            roast_door.SetView(30, 0, 0);
            roast_door.Animate(0, 2, eOnce, eBlock);
            player.DoorHandle2();
            PlayDoorCloseSound();
            FadeCharacterOut_NoBlock(player, 99, -15, 0);
            roast_door.Animate(1, 1, eOnce, eBlock);
            player.ChangeRoom(27, 121, 155);
        }
    }
}
function room_RepExec(){
    if ((gBonus.Visible==false)&&(gGameover.Visible==false)&&(gBreakdown.Visible==false)&&(gStock.Visible==false)){

        if ((ampm==0)&&((hour<8)&&(hour>=1))){//Dark - Early Morning
            NatMusic(27); SetBackgroundFrame(1); sun.Graphic=1709; mtns.Graphic=1712;  oObject2.Graphic=1711; org_door.Graphic=5448; awning.Graphic=5156;
        }//Dark
        if ((ampm==0)&&(hour>=8)&&(hour!=12)){//Morning
            NatMusic(26); SetBackgroundFrame(0); sun.Graphic=281; mtns.Graphic=124; oObject2.Graphic=400; org_door.Graphic=5449; awning.Graphic=5155;
        }//Light
        if ((ampm==1)&&(hour==12)){//NOON
            NatMusic(26); SetBackgroundFrame(0); sun.Graphic=281; mtns.Graphic=124; oObject2.Graphic=400; org_door.Graphic=5449; awning.Graphic=5155;
        }//Light
        if ((ampm==1)&&(hour<=8)&&(hour!=12)){//day
            NatMusic(26); SetBackgroundFrame(0); sun.Graphic=281; mtns.Graphic=124; oObject2.Graphic=400; org_door.Graphic=5449; awning.Graphic=5155;
        }//Light
        if ((ampm==1)&&(hour>=9)&&(hour!=12)){//Night
            NatMusic(27); SetBackgroundFrame(1); sun.Graphic=1709; mtns.Graphic=1712;  oObject2.Graphic=1711; org_door.Graphic=5448; awning.Graphic=5156;
        }//Dark
        if ((ampm==0)&&(hour==12)){//Midnight
            NatMusic(27); SetBackgroundFrame(1); sun.Graphic=1709; mtns.Graphic=1712;  oObject2.Graphic=1711; org_door.Graphic=5448; awning.Graphic=5156;
        }//Dark

        ////////DELETE THIS LINE!!!!!!!!!!!!!!!!!!!!!////////DELETE THIS LINE!!!!!!!!!!!!!!!!!!!!!////////DELETE THIS LINE!!!!!!!!!!!!!!!!!!!!!
        //Makes background transp.
        //if ((IsKeyPressed(78)==1)&&(gSavegame.Visible==false)&&(gLoadgame.Visible==false)){
        //if ((gLoadgame.Visible==true)||(gSavegame.Visible==true)){}
        //else{oObject2.Transparency=100; awning.Transparency=100; sun.Transparency=100; mtns.Transparency=100; }}

        if (GetGlobalInt(GI_CHARACTER)==3){Stand.Baseline=(cEgo.y+1);}
        if (GetGlobalInt(GI_CHARACTER)==4){Stand.Baseline=(cLogan.y+1);}
        int id = 9;
        while (id <= 50) // run for characters with the following IDs: 2, 3, 4, 5, 6
        {
            if ((character[ id ].Room==player.Room)&&((character[ id ].x >= 750)||(character[id ].x <= 2))){  character[ id ].ChangeRoom(24, 100, 100);}
            id ++; // proceed to testing the next character in a row
        }

    }
}//End Repex

function room_AfterFadeIn()
{
    FadeObjectOut_NoBlock(musicplate, 99, 10, 0);
    if (GetGlobalInt(GI_MUSIC_BARBARA)==0){UnlockMusic(); SetGlobalInt(GI_MUSIC_BARBARA, 1);}
}

function region2_Standing(){
    if((IsKeyPressed(eKeyUpArrow)==1)||(IsKeyPressed(eKeyW)==1)&&(gMake.Visible==false)){//Cass
        if (((ampm==1)&&(hour>10)&&(hour!=12))||((ampm==0)&&((hour<11)))||((ampm==0)&&((hour==12))))
        {
            Wait(5); player.DoorHandle(); Wait(20); PlaySound(60);
            TopUp("Locked", "This door won't open. It's locked."); player.DoorHandle2();
        }
        else
        {
            if ((GetGlobalInt(GI_CHARACTER)==3)&&(GetGlobalInt(GI_CART_STATE) == 1)){Stand.UnlockView(); SetGlobalInt(GI_CART_STATE, 3); Stand.FollowCharacter(null, 0, 0); Wait(5);}
            player.DoorHandle();
            PlayDoorOpenSound();
            cassdoor.SetView(45, 0, 0);
            cassdoor.Animate(0, 2, eOnce, eBlock);
            player.DoorHandle2();
            PlayDoorCloseSound();
            FadeCharacterOut_NoBlock(player, 99, -15, 0);
            cassdoor.Animate(1, 1, eOnce, eBlock);
            player.ChangeRoom(30, 238, 108);
        }
    }
}

