// room script file
function on_event(EventType event, int data) {
    if (event==eEventEnterRoomBeforeFadein)
    {
        ApplyMusicVolume();

        if (GetGlobalInt(GI_ANDRUS_PROGRESS) == 1){FS.Transparency=0; FS.Graphic=118;}
        else if (GetGlobalInt(GI_ANDRUS_PROGRESS) == 3){FS.Transparency=0; FS.Graphic=1407;}
        else if (GetGlobalInt(GI_ANDRUS_PROGRESS) == 10){FS.Transparency=0; FS.Graphic=1407;}
        if (Stand.Room==11){Stand.Transparency=99;}
    }
}


function room_AfterFadeIn()
{
    Wait(80);
    SetNextScreenTransition(eTransitionCrossfade);
    if (GetGlobalInt(GI_ANDRUS_PROGRESS) == 1){player.ChangeRoom(5, 143, 158);}
    else if (GetGlobalInt(GI_ANDRUS_PROGRESS) == 3){player.ChangeRoom(7, 27, 193);}
    else if (GetGlobalInt(GI_ANDRUS_PROGRESS) == 10){SetGlobalInt(GI_ANDRUS_HOTEL_INSIDE, 1); player.ChangeRoom(7, 257, 138);}
}
