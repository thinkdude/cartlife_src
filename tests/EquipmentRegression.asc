function QaCheck(bool passed, String description) {
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  if (report==null) AbortGame("Cannot open regression results");
  if (passed) report.WriteRawLine(String.Format("PASS %s",description));
  else report.WriteRawLine(String.Format("FAIL %s",description));
  report.Close();
}

bool QaNear(float actual, float expected) {
  return (actual>expected-0.001)&&(actual<expected+0.001);
}

function QaPrepare(int protagonist, int sprite, float cash) {
  CloseAll(); SetGlobalInt(1,protagonist);
  barspeed=1; vitality.Width=120;
  Money=cash; buyprice=999.99;
  localbucks=0.00; walmartia=0.00;
  expense_misc=0.00; expense_equipment=0.00;
  cSlot1.InventoryQuantity[espressomachine.ID]=0;
  cSlot1.InventoryQuantity[maker.ID]=0;
  cSlot1.InventoryQuantity[Emachine.ID]=0;
  cSlot2.InventoryQuantity[Headunit.ID]=0;
  cSlot2.InventoryQuantity[Drinkbook.ID]=0;
  upgrade_4.NormalGraphic=1278;
  gBuyItem.BackgroundGraphic=sprite; gBuyItem.Visible=true;
}

function QaRun() {
  QaPrepare(2,3890,70.00); TJ.InventoryQuantity[bHeadunit.ID]=1;
  bBuy_Button_OnClick(null,eMouseLeft);
  QaCheck(cSlot2.InventoryQuantity[Headunit.ID]==1,"pawn-shop stereo purchase delivers the head unit");
  QaCheck(QaNear(Money,0.00),"pawn-shop stereo charges seventy dollars once");
  QaCheck(QaNear(localbucks,70.00),"pawn-shop stereo spending matches the payment");
  QaCheck(QaNear(expense_equipment,70.00)&&QaNear(expense_misc,0.00),"stereo purchase is classified as equipment");
  QaCheck(TJ.InventoryQuantity[bHeadunit.ID]==0,"stereo purchase removes the seller's unit");
  QaCheck(!gBuyItem.Visible,"sold-out stereo closes its purchase popup");

  QaPrepare(2,3890,69.99); TJ.InventoryQuantity[bHeadunit.ID]=1;
  bBuy_Button_OnClick(null,eMouseLeft);
  QaCheck(QaNear(Money,69.99)&&(cSlot2.InventoryQuantity[Headunit.ID]==0),"insufficient stereo payment preserves cash and inventory");
  QaCheck(TJ.InventoryQuantity[bHeadunit.ID]==1,"rejected stereo purchase preserves seller stock");

  QaPrepare(2,713,200.00);
  bBuy_Button_OnClick(null,eMouseLeft);
  QaCheck(cSlot1.InventoryQuantity[espressomachine.ID]==1,"Melanie can buy the basic espresso machine");
  QaCheck(QaNear(Money,0.00)&&QaNear(expense_equipment,200.00),"basic espresso machine has the correct payment and cost");

  QaPrepare(1,713,200.00);
  bBuy_Button_OnClick(null,eMouseLeft);
  QaCheck(QaNear(Money,200.00)&&(cSlot1.InventoryQuantity[espressomachine.ID]==0),"Andrus without training cannot buy the espresso machine");
  cSlot2.InventoryQuantity[Drinkbook.ID]=1;
  bBuy_Button_OnClick(null,eMouseLeft);
  QaCheck(QaNear(Money,0.00)&&(cSlot1.InventoryQuantity[espressomachine.ID]==1),"Andrus with the drink book can buy the espresso machine");

  QaPrepare(3,713,200.00); cSlot2.InventoryQuantity[Drinkbook.ID]=1;
  upgrade_4.NormalGraphic=105;
  bBuy_Button_OnClick(null,eMouseLeft);
  QaCheck(QaNear(Money,200.00)&&(cSlot1.InventoryQuantity[espressomachine.ID]==0),"Vinny needs a battery before buying an espresso machine");
  upgrade_4.NormalGraphic=1278;
  bBuy_Button_OnClick(null,eMouseLeft);
  QaCheck(QaNear(Money,0.00)&&(cSlot1.InventoryQuantity[espressomachine.ID]==1),"Vinny with battery and training can buy an espresso machine");

  QaPrepare(3,715,40.00); upgrade_4.NormalGraphic=105;
  bBuy_Button_OnClick(null,eMouseLeft);
  QaCheck(QaNear(Money,40.00)&&(cSlot1.InventoryQuantity[maker.ID]==0),"coffee maker rejects a cart without a battery");
  upgrade_4.NormalGraphic=1278;
  bBuy_Button_OnClick(null,eMouseLeft);
  QaCheck(QaNear(Money,0.00)&&(cSlot1.InventoryQuantity[maker.ID]==1),"coffee maker purchase succeeds with the required battery");

  QaPrepare(2,479,3000.00); cBarneys.InventoryQuantity[bEMachine.ID]=1;
  bBuy_Button_OnClick(null,eMouseLeft);
  QaCheck(QaNear(Money,0.00)&&(cSlot1.InventoryQuantity[Emachine.ID]==1),"premium espresso purchase delivers the paid machine");
  QaCheck(QaNear(localbucks,3000.00)&&QaNear(expense_equipment,3000.00),"premium espresso purchase records the full equipment cost");
  QaCheck(cBarneys.InventoryQuantity[bEMachine.ID]==0,"premium espresso purchase removes seller stock");
  QaCheck(!gBuyItem.Visible,"sold-out premium machine closes its purchase popup");
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt",eFileAppend);
  report.WriteRawLine("COMPLETE"); report.Close(); QuitGame(0);
}
