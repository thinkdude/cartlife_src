function QaCheck(bool passed, String description) {
  File* f=File.Open("$SAVEGAMEDIR$/regression-results.txt",eFileAppend);
  if (f==null) AbortGame("Cannot open regression results");
  if (passed) f.WriteRawLine(String.Format("PASS %s",description));
  else f.WriteRawLine(String.Format("FAIL %s",description));
  f.Close();
}
bool QaNear(float actual,float expected) {return (actual>expected-0.001)&&(actual<expected+0.001);}

function QaPrepareBagel(int preference) {
  CloseAll(); SetGlobalInt(1,3); barspeed=1; SetGameSpeed(200);
  Customer=Richard; salebuyer="Richard";
  Customer.SetProperty("prefBagel_p",preference);
  Customer.SetProperty("limitBagel_p",50000);
  Money=0.00; income_total=0.00; income_today=0.00; total_solditems=0;
  Bagel_PlainSold=0; Bagel_PlainNet=0.00; Bagel_PlainGross=0.00;
  Bagel_PlainPrice=3.00; Creamcheese_Price=1.00; PBJ_Price=1.25;
  Toasted_Price=0.50; Lox_Price=2.00; rep=20; repmod=0.00;
  bagel_plain_remaining=5; creamcheese_remaining=3; vcheese_remaining=0;
  cream_remaining=0; peanutbutter_remaining=3; jelly_remaining=3;
  lox_remaining=3; capers_remaining=3;
  upgrade_2.NormalGraphic=1325;
  vitality.Width=120; nutrition.Width=110; happiness=0;
  orderremaining=0; orderbotched=1; ChangeAnswer=100.00;
  besttime=0; cd_seconds=10; cd_miliseconds=0; killpapers=false; total_botched=0;
  Menu.Clear(); Menu.AddItem("Plain Bagel"); Menu.AddItem("Pipeline Crest");
  Phrase="OLD ORDER"; SaleInProgress=1;
  gDialog.Visible=true; DBG0.NormalGraphic=2184;
}

function QaFinishBagel(float expected,String description) {
  orderbotched=1; checkout();
  QaCheck(QaNear(Money,expected),String.Format("%s credits the complete sale price",description));
  QaCheck(QaNear(income_total,expected)&&QaNear(income_today,expected),String.Format("%s records the complete income",description));
  QaCheck((bagel_plain_remaining==4)&&(Bagel_PlainSold==1),String.Format("%s consumes and counts one bagel",description));
}

function QaRun() {
  QaPrepareBagel(1); Customer.sellBagel_Plain();
  QaCheck(saleitem=="Bagel with Cream Cheese","store-bought cream cheese keeps the accepted order type");
  QaCheck(QaNear(saleprice,4.00),"cream-cheese change calculation includes the extra charge");
  QaCheck(creamcheese_remaining==3,"cream-cheese preparation does not consume ingredients early");
  QaFinishBagel(4.00,"store-bought cream cheese");
  QaCheck(creamcheese_remaining==2,"completed sale consumes one store-bought cream-cheese portion");

  QaPrepareBagel(1); vcheese_remaining=2; creamcheese_remaining=0;
  Customer.sellBagel_Plain();
  QaCheck(vcheese_remaining==2,"homemade cream cheese is not consumed while ordering");
  QaFinishBagel(4.00,"homemade cream cheese");
  QaCheck(vcheese_remaining==1,"completed sale consumes homemade cream cheese exactly once");

  QaPrepareBagel(3); Customer.sellBagel_Plain();
  QaCheck(saleitem=="Bagel with Peanut Butter and Jelly","PBJ negotiation retains its order type");
  QaCheck(QaNear(saleprice,4.25),"PBJ change calculation includes both base and topping");
  QaCheck((peanutbutter_remaining==3)&&(jelly_remaining==3),"PBJ ingredients wait until the sale completes");
  QaCheck(Phrase!="OLD ORDER","PBJ preparation receives a fresh typing phrase");
  step1_OnClick(null,eMouseLeft);
  QaCheck((GetTextHeight(confirm_ac.Text,confirm_ac.Font,confirm_ac.Width)<=confirm_ac.Height)&&(GetTextHeight(confirm_bd.Text,confirm_bd.Font,confirm_bd.Width)<=confirm_bd.Height),"PBJ confirmation text fits both answer labels");
  QaFinishBagel(4.25,"PBJ bagel");
  QaCheck((peanutbutter_remaining==2)&&(jelly_remaining==2),"completed PBJ sale consumes one portion of each topping");

  QaPrepareBagel(2); Customer.sellBagel_Plain();
  QaCheck(saleitem=="Bagel with Lox and Capers","lox negotiation retains its order type");
  QaCheck(QaNear(saleprice,5.00),"lox change calculation includes the extra charge");
  QaCheck((lox_remaining==3)&&(capers_remaining==3),"lox ingredients wait until the sale completes");
  QaCheck(Phrase!="OLD ORDER","lox preparation receives a fresh typing phrase");
  QaFinishBagel(5.00,"lox bagel");
  QaCheck((lox_remaining==2)&&(capers_remaining==2),"completed lox sale consumes one portion of each topping");

  QaPrepareBagel(5); vcheese_remaining=2; Customer.sellBagel_Plain();
  QaCheck(saleitem=="Toasted Bagel","toasting keeps the accepted order type");
  QaCheck(QaNear(saleprice,3.50),"toasted-bagel change calculation includes the extra charge");
  QaCheck(vcheese_remaining==2,"toasting does not consume unrelated homemade cream cheese");
  QaCheck(Phrase!="OLD ORDER","toasted preparation receives a fresh typing phrase");
  QaFinishBagel(3.50,"toasted bagel");
  QaCheck(vcheese_remaining==2,"completed toasted sale preserves unrelated cream cheese");

  QaPrepareBagel(1); Creamcheese_Price=50.00; Customer.SetProperty("limitBagel_p",400); rep=0;
  Customer.sellBagel_Plain();
  QaCheck((saleitem=="Plain Bagel")&&QaNear(saleprice,3.00),"unaffordable topping falls back to the plain price");
  QaFinishBagel(3.00,"plain fallback");
  QaCheck(creamcheese_remaining==3,"plain fallback preserves the unused topping");

  QaPrepareBagel(3); Customer.sellBagel_Plain(); gAssemble.Visible=true; Botch();
  QaCheck((total_botched==1)&&(bagel_plain_remaining==4),"spilled PBJ preparation wastes one bagel");
  QaCheck((peanutbutter_remaining==2)&&(jelly_remaining==2),"spilled PBJ preparation wastes each topping once");
  QaCheck(QaNear(Money,0.00)&&(Bagel_PlainSold==0),"spilled PBJ preparation earns no sale");
  orderbotched=1; checkout();
  QaCheck(QaNear(Money,4.25)&&QaNear(income_total,4.25)&&(Bagel_PlainSold==1),"successful PBJ retry earns exactly one complete sale");
  QaCheck((bagel_plain_remaining==3)&&(peanutbutter_remaining==1)&&(jelly_remaining==1),"successful retry consumes its own bagel and toppings");

  QaPrepareBagel(2); Customer.sellBagel_Plain(); gAssemble.Visible=true; Botch();
  QaCheck((bagel_plain_remaining==4)&&(lox_remaining==2)&&(capers_remaining==2),"spilled lox preparation wastes one bagel and each topping");

  QaPrepareBagel(1); vcheese_remaining=2; creamcheese_remaining=0;
  Customer.sellBagel_Plain(); gAssemble.Visible=true; Botch();
  QaCheck((bagel_plain_remaining==4)&&(vcheese_remaining==1),"spilled homemade cream-cheese preparation consumes one portion");
  File* f=File.Open("$SAVEGAMEDIR$/regression-results.txt",eFileAppend);
  f.WriteRawLine("COMPLETE"); f.Close(); QuitGame(0);
}
