function QaCheck(bool passed,String description) {
  File* f=File.Open("$SAVEGAMEDIR$/regression-results.txt",eFileAppend);
  if (f==null) AbortGame("Cannot open regression results");
  if (passed) f.WriteRawLine(String.Format("PASS %s",description));
  else f.WriteRawLine(String.Format("FAIL %s",description));
  f.Close();
}
function QaOrderCase(int count,int choice,String item,String expected) {
  CloseAll(); SetGlobalInt(1,3); qaQuiz=choice;
  Menu.Clear(); int i=0;
  while (i<count) {Menu.AddItem(String.Format("Menu item %d",i)); i++;}
  saleitem=item;
  step1.NormalGraphic=5517;
  step1_OnClick(null,eMouseLeft);
  if ((count==4)&&(choice==0)) {
    File* metric=File.Open("$SAVEGAMEDIR$/label-metrics.txt",eFileWrite);
    metric.WriteRawLine(String.Format("AC: font %d width %d height %d required %d text %s",confirm_ac.Font,confirm_ac.Width,confirm_ac.Height,GetTextHeight(confirm_ac.Text,confirm_ac.Font,confirm_ac.Width),confirm_ac.Text));
    metric.WriteRawLine(String.Format("BD: font %d width %d height %d required %d text %s",confirm_bd.Font,confirm_bd.Width,confirm_bd.Height,GetTextHeight(confirm_bd.Text,confirm_bd.Font,confirm_bd.Width),confirm_bd.Text));
    metric.Close();
  }
  String shown=confirm_ac.Text;
  if (choice>=2) shown=confirm_bd.Text;
  int newline=shown.IndexOf("[");
  String answer=shown;
  if (newline>=0) {
    if ((choice==0)||(choice==2)) answer=shown.Substring(0,newline);
    else answer=shown.Substring(newline+1,shown.Length-newline-1);
  }
  QaCheck(answer==expected,String.Format("%s menu %d quiz %d shows the accepted order at its answer position",expected,count,choice));
  QaCheck((GetTextHeight(confirm_ac.Text,confirm_ac.Font,confirm_ac.Width)<=confirm_ac.Height)&&(GetTextHeight(confirm_bd.Text,confirm_bd.Font,confirm_bd.Width)<=confirm_bd.Height),String.Format("menu %d quiz %d fits the confirmation labels",count,choice));
  confirmbox.Text=OrderAnswer; total_botched=0;
  confirmbox_OnActivate(null);
  QaCheck(gAssemble.Visible&&(total_botched==0),String.Format("menu %d quiz %d accepts the displayed correct choice",count,choice));
}
function QaRun() {
  QaCheck(true,"order-choice boundary test entered");
  // A topped bagel with exactly four menu entries crashes the original code.
  QaOrderCase(4,0,"Bagel with Peanut Butter and Jelly","PB+J Bagel");
  int count=0;
  while (count<=6) {
    int choice=0;
    while (choice<4) {QaOrderCase(count,choice,"Bagel with Peanut Butter and Jelly","PB+J Bagel"); choice++;}
    count++;
  }
  int choice=0;
  while (choice<4) {
    QaOrderCase(2,choice,"Bagel with Cream Cheese","Cream Cheese");
    QaOrderCase(2,choice,"Bagel with Lox and Capers","Lox + Capers");
    QaOrderCase(2,choice,"Toasted Bagel","Toasted Bagel");
    QaOrderCase(2,choice,"Plain Bagel","Plain Bagel");
    choice++;
  }
  File* f=File.Open("$SAVEGAMEDIR$/regression-results.txt",eFileAppend);
  f.WriteRawLine("COMPLETE"); f.Close(); QuitGame(0);
}
