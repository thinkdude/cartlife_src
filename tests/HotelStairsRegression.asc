// Exercises room 7's actual stair handlers in a disposable project.
int qaStairPhase;
int qaLandingTicks;
bool qaStairTrigger;

function QaCheck(bool passed, String description) {
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  if (report==null) AbortGame("Cannot open regression results");
  if (passed) report.WriteRawLine(String.Format("PASS %s", description));
  else report.WriteRawLine(String.Format("FAIL %s", description));
  report.Close();
}

function QaRun() {
  cAndrus.ChangeRoom(player.Room, player.x, player.y);
  cAndrus.SetAsPlayer();
  cAndrus.SetIdleView(-1, 0);
  player.ChangeView(3);
  CloseAll();
  gPick.Visible=false;
  mouse.Visible=false;
  SetGlobalInt(1, 1);
  SetGlobalInt(101, 13);
  SetGlobalInt(10, 0);
  SetGlobalInt(11, 0);
  SetGlobalInt(52, 1);
  caffeine.Width=110;
  player.ChangeRoom(7, 474, 193);
}

bool QaForceStairs() { return qaStairTrigger; }

function QaHotelPrepare(int carryingCat) {
  player.UnlockView();
  player.ChangeView(3);
  player.x=474;
  player.y=193;
  xmove=0;
  SetGlobalInt(11, carryingCat);
  qaStairTrigger=true;
}

function QaHotelLanding(int expectedX, int expectedY, int flight) {
  QaCheck((player.Room==7)&&(player.x==expectedX)&&(player.y==expectedY), String.Format("cat %d stair %d reaches landing", GetGlobalInt(11), flight));
  caffeine.Width=40;
  SetTimer(19, 1);
  Wait(2);
  UpdateAndrusWithdrawal();
  QaCheck((player.Room==7)&&(player.x==expectedX)&&(player.y==expectedY), String.Format("cat %d stair %d cough preserves landing", GetGlobalInt(11), flight));
  QaCheck(player.View==player.NormalView, String.Format("cat %d stair %d cough releases view", GetGlobalInt(11), flight));
}

function QaHotelSettle() {
  qaStairTrigger=false;
  SetGlobalInt(11, 0);
  player.UnlockView();
  player.x=417;
  player.y=139;
  xmove=0;
  caffeine.Width=40;
  SetTimer(19, 1);
  Wait(2);
  UpdateAndrusWithdrawal();
  qaStairPhase=1;
}

bool QaHotelReady() { return qaStairPhase==0; }

function QaHotelTick() {
  if (qaStairPhase==0) return;
  qaLandingTicks++;
  if (qaLandingTicks<40) return;
  QaCheck((player.Room==7)&&(player.x==417)&&(player.y==139), String.Format("landing remains stable for 40 gameplay frames (room %d, x %d, y %d)", player.Room, player.x, player.y));
  File* report=File.Open("$SAVEGAMEDIR$/regression-results.txt", eFileAppend);
  report.WriteRawLine("COMPLETE");
  report.Close();
  QuitGame(0);
}
