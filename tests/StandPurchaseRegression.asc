function QaCheck(bool passed,String description) {
  File* f=File.Open("$SAVEGAMEDIR$/regression-results.txt",eFileAppend);
  if (f==null) AbortGame("Cannot open regression results");
  if (passed) f.WriteRawLine(String.Format("PASS %s",description));
  else f.WriteRawLine(String.Format("FAIL %s",description));
  f.Close();
}
bool QaNear(float value,float expected) {return (value>expected-0.001)&&(value<expected+0.001);}
function QaStand(float cash) {
  CloseAll(); SetGlobalInt(1,2); barspeed=1;
  Customer=Alice_2; salebuyer="Alice";
  gMachine.Visible=true; gAppearance_v.Visible=false;
  Money=cash; expense_upgrade=0.00; expenselist.Clear(); vitality.Width=120;
  speakmind(57);
}
function QaRun() {
  QaStand(0.00);
  QaCheck(QaNear(Money,0.00),"zero cash cannot buy Melanie's stand on credit");
  QaCheck(QaNear(expense_upgrade,0.00)&&!gAppearance_v.Visible,"rejected stand purchase records no upgrade and opens no design step");
  QaStand(1199.99);
  QaCheck(QaNear(Money,1199.99),"one cent below the stand price preserves the balance");
  QaCheck(QaNear(expense_upgrade,0.00)&&(expenselist.ItemCount==0),"unaffordable stand adds no expense entry");
  QaStand(1200.00);
  QaCheck(QaNear(Money,0.00)&&QaNear(expense_upgrade,1200.00),"exact stand payment charges twelve hundred dollars once");
  QaCheck(gAppearance_v.Visible&&(expenselist.ItemCount==1),"affordable stand purchase proceeds to its design step");
  QaStand(1500.00);
  QaCheck(QaNear(Money,300.00)&&QaNear(expense_upgrade,1200.00),"stand purchase leaves the correct remaining balance");
  File* f=File.Open("$SAVEGAMEDIR$/regression-results.txt",eFileAppend);
  f.WriteRawLine("COMPLETE"); f.Close(); QuitGame(0);
}
